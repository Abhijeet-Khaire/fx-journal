rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/traders/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/traders/$(request.auth.uid)).data.role == 'superadmin';
    }

    // Traders Collection
    match /traders/{userId} {
      // Superadmins can read any trader doc; users can only read their own doc
      allow read: if isOwner(userId) || isAdmin();

      // Only superadmin can list all traders
      allow list: if isAdmin();

      // Creation: User can create their initial profile, but cannot self-assign 'superadmin' role
      allow create: if isOwner(userId) && (
        !('role' in request.resource.data) || request.resource.data.role != 'superadmin'
      ) || isAdmin();

      // Update: User can update profile, but cannot elevate/alter 'role' to superadmin
      allow update: if isOwner(userId) && (
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']) ||
        request.resource.data.role == resource.data.role
      ) || isAdmin();

      // Delete: Only user or admin
      allow delete: if isOwner(userId) || isAdmin();

      // Subcollections (trade-history, challenges, calendar, analytics, settings, etc.)
      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
